<usereventscript scriptid="customscript_acme_inbship_gate_ue">
  <description>Disables Receive on Inbound Shipments that are not ready to be received.</description>
  <isinactive>F</isinactive>
  <name>ACME - Inbound Shipment gate</name>
  <notifyowner>T</notifyowner>
  <scriptfile>[/SuiteScripts/acme_inbship/acme_inbship_gate_ue.js]</scriptfile>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_acme_gate2_lc_confirmed_id">
      <fieldtype>TEXT</fieldtype><label>LC Status 'Confirmed' internal id</label><defaultvalue>3</defaultvalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_acme_inbship_gate_ue">
      <allroles>T</allroles>
      <custscript_acme_gate2_lc_confirmed_id>3</custscript_acme_gate2_lc_confirmed_id>
      <executioncontext>USERINTERFACE</executioncontext>
      <isdeployed>T</isdeployed>
      <loglevel>AUDIT</loglevel>
      <recordtype>INBOUNDSHIPMENT</recordtype>
      <status>RELEASED</status>
    </scriptdeployment>
  </scriptdeployments>
</usereventscript>
